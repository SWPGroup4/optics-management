      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result.accessToken).to.be.a('string');",
                  "});",
                  "",
                  "// Store token for subsequent requests",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', jsonData.result.accessToken);",
                  "pm.collectionVariables.set('refreshToken', jsonData.result.refreshToken);",
                  "pm.collectionVariables.set('userId', jsonData.result.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
